{
  "name": "profile-switcher",
  "productName": "Profile Switcher",
  "desktopName": "profile-switcher.desktop",
  "version": "0.1.0",
  "description": "A cross-platform desktop app to switch between isolated profiles for AI coding tools and developer applications.",
  "license": "MIT",
  "author": {
    "name": "Profile Switcher contributors",
    "email": "ifazelman@gmail.com"
  },
  "homepage": "https://github.com/FazelMan/profile-switcher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FazelMan/profile-switcher.git"
  },
  "bugs": {
    "url": "https://github.com/FazelMan/profile-switcher/issues"
  },
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "package": "npm run build && electron-builder --config electron-builder.config.cjs --publish never",
    "package:dir": "npm run build && electron-builder --config electron-builder.config.cjs --dir --publish never",
    "package:linux": "npm run build && electron-builder --config electron-builder.config.cjs --linux --publish never",
    "package:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac --publish never",
    "package:win": "npm run build && electron-builder --config electron-builder.config.cjs --win --publish never",
    "release:verify-version": "node scripts/verify-release.mjs",
    "icons": "node scripts/render-icon.mjs"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.3",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "lucide-react": "1.55.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
